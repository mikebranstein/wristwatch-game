{
  "name": "wristwatch-game",
  "version": "0.1.0",
  "description": "Wristwatch Revival Simulator — a watch-repair puzzle game",
  "main": "src/index.js",
  "scripts": {
    "test": "jest --coverage",
    "check:boundary": "node scripts/check-boundary.js",
    "test:all": "node scripts/run-all-tests.js",
    "test:all:coverage": "node scripts/run-all-tests.js --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/javascript/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "ajv": "^8.0.0"
  },
  "license": "MIT"
}
